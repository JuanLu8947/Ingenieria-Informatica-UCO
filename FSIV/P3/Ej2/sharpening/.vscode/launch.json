      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "sharpen (radiografia)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../build-${workspaceFolderBasename}/sharpen",
      "args": ["-i", "${workspaceFolder}/data/radiografia.png", "sal.png"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/../build-${workspaceFolderBasename}",
      "environment": [],
