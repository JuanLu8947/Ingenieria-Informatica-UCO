  "version": "0.2.0",
  "configurations": [
    {
      "name": "sharpen (ciclista_original)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../build-${workspaceFolderBasename}/sharpen",
      "args": [
        "-i",
        "${workspaceFolder}/data/ciclista_original.jpg",
        "sal.png"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/../build-${workspaceFolderBasename}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "sharpen (cells)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../build-${workspaceFolderBasename}/sharpen",
      "args": ["-i", "${workspaceFolder}/data/cells.png", "sal.png"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/../build-${workspaceFolderBasename}",
