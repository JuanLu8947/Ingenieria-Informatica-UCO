{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "edge_detector (2018)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../build-${workspaceFolderBasename}/edge_detector",
      "args": [
        "-i",
        "${workspaceFolder}/data/mini-berkely/2018.jpg",
        "sal.png",
        "${workspaceFolder}/data/mini-berkely/2018_gt.png"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/../build-${workspaceFolderBasename}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "edge_detector (6046)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../build-${workspaceFolderBasename}/edge_detector",
      "args": [
        "-i",
        "${workspaceFolder}/data/mini-berkely/6046.jpg",
        "sal.png",
        "${workspaceFolder}/data/mini-berkely/6046_gt.png"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/../build-${workspaceFolderBasename}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
